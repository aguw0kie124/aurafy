# Frontend
PUBLIC_API_BASE_URL=http://127.0.0.1:5057
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5057/api/auth/spotify/callback

# Playlist builder — natural-language mode (free Gemini key from https://aistudio.google.com/apikey).
# Optional: without it, parameter-based playlist building still works.
GEMINI_API_KEY=

# Database (Supabase Postgres — use the Session pooler connection string)
SUPABASE_DB_URL=

# Encrypts Spotify tokens at rest. Generate once and never lose it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
